# Copie este arquivo para ".env.local" e preencha com os dados do seu app web no Firebase
# (Console do Firebase > Configurações do projeto > Seus aplicativos > Configuração do SDK).
# O ".env.local" não vai para o Git. O passo a passo está em docs/firebase-setup.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
